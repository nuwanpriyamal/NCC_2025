pipeline {
    agent any
    
    environment {
        DOCKER_USERNAME = 'nuwanpriyamal'
    }
    
    stages {
        stage('Stage 1: Git Pull') {
            steps {
                echo 'Stage 1: Pulling Git Repository'
                git branch: 'gscomp268', url: 'https://github.com/nuwanpriyamal/NCC_2025.git'
                sh 'git log --oneline -1'
            }
        }
        
        stage('Stage 2: Build with Docker Plugin') {
            steps {
                echo 'Stage 2: Building Docker Images'
                script {
                    def backendImage = docker.build("nuwanpriyamal/backend2:latest", "./backend2")
                    def frontendImage = docker.build("nuwanpriyamal/frontend2:latest", "./frontend2")
                }
            }
        }
        
        stage('Stage 3: Push to Docker Hub') {
            steps {
                echo 'Stage 3: Pushing Images to Docker Hub'
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'docker-hub-credentials') {
                        docker.image("nuwanpriyamal/backend2:latest").push()
                        docker.image("nuwanpriyamal/frontend2:latest").push()
                    }
                }
            }
        }
    }
    
    post {
        always {
            echo 'Pipeline completed'
        }
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}
