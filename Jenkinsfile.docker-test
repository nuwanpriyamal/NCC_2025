pipeline {
    agent any
    
    environment {
        DOCKER_USERNAME = 'nuwanpriyamal'
    }
    
    stages {
        stage('Stage 1: Git Pull') {
            steps {
                echo 'Stage 1: Pulling Git Repository'
                git branch: 'gscomp268', url: 'https://github.com/nuwanpriyamal/NCC_2025.git'
                sh 'git log --oneline -1'
            }
        }
        
        stage('Stage 2: Find Docker') {
            steps {
                echo 'Stage 2: Finding Docker installation'
                sh 'which docker || echo "Docker not in PATH"'
                sh 'ls -la /usr/local/bin/docker || echo "Docker not in /usr/local/bin"'
                sh 'ls -la /usr/bin/docker || echo "Docker not in /usr/bin"'
                sh 'find /usr -name docker 2>/dev/null | head -5 || echo "Docker not found in /usr"'
                sh 'echo $PATH'
            }
        }
        
        stage('Stage 3: Test Docker with Full Path') {
            steps {
                echo 'Stage 3: Testing Docker with full path'
                sh '/usr/local/bin/docker --version || echo "Docker not accessible"'
                sh '/usr/local/bin/docker info || echo "Docker daemon not accessible"'
            }
        }
    }
    
    post {
        always {
            echo 'Pipeline completed'
        }
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}
